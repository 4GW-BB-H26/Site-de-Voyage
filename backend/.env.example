# Port HTTP de l’API Express
PORT=3000

# Où sont stockés les comptes : oracle = table USERS | mongo = collection (pratique si Oracle coince encore)
AUTH_MODE=oracle

# JWT — en prod, mets une vraie clé longue (ex. openssl rand -base64 32)
JWT_SECRET=votre_cle_secrete_jwt
JWT_EXPIRES_IN=7d

ORACLE_USER=ProjetVoyage
ORACLE_PASSWORD=votre_mot_de_passe
# Doit matcher ce que tu vois dans SQL Developer / lsnrctl services (FREEPDB1, XEPDB1, ORCL…)
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# MongoDB (favoris, commentaires, et auth si AUTH_MODE=mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=voyage_db
