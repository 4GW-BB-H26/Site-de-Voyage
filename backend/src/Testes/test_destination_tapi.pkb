create or replace package body test_destination_tapi is

   -- generated by utPLSQL for SQL Developer on 2026-03-10 18:13:15

   l_id_destination number := 1;
   l_reponse_obj    varchar2(4000);

   -- test ins
   procedure ins_destination is

      l_city       destination.city%type;
      l_country    destination.country%type;
      l_image_link destination.image_link%type;
      l_mode_test  char(1);
   begin
      l_city := 'Paris';
      l_country := 'France';
      l_image_link := 'paris.jpg';
      l_mode_test := 'O';
      l_reponse_obj := destination_tapi.ins_destination(
         l_city,
         l_country,
         l_image_link,
         l_mode_test
      );
      l_id_destination := json_value(l_reponse_obj,
           '$.data.id_destination');
      dbms_output.put_line('ins_destination - l_reponse_obj: ' || l_reponse_obj);
      dbms_output.put_line('ins_destination - l_id_destination: ' || l_id_destination);
      ut.expect(l_id_destination).to_be_greater_or_equal(1);
   end ins_destination;


   -- test ins
   procedure ins_destination_null is
      l_city       destination.city%type;
      l_country    destination.country%type;
      l_image_link destination.image_link%type;
      l_mode_test  char(1);
   begin
      l_city := null; --ville Null test
      l_country := 'France';
      l_image_link := 'paris.jpg';
      l_mode_test := 'O';
      l_reponse_obj := destination_tapi.ins_destination(
         l_city,
         l_country,
         l_image_link,
         l_mode_test
      );
      ut.fail('Une exception devait se produire mais ne s'' est pas produite');
   exception
      when others then
         ut.expect(sqlcode).to_equal(-1400);
   end ins_destination_null; --
   
   
   -- test upd
   procedure upd_destination is
      l_city           destination.city%type;
      l_id_destination number := 1;
      l_country        destination.country%type;
      l_image_link     destination.image_link%type;
      l_mode_test      char(1);
      l_nbre_rangee    number := 0;
   begin
      l_city := 'Lyon';
      l_country := 'France';
      l_image_link := 'lyon.jpg';
      l_mode_test := 'O';
      l_reponse_obj := destination_tapi.upd_destination(
         l_city,
         l_id_destination,
         l_country,
         l_image_link,
         l_mode_test
      );
      l_nbre_rangee := json_value(l_reponse_obj,
           '$.nbre_rangee');
      dbms_output.put_line('upd_destination - l_id_destination: ' || l_id_destination);
      dbms_output.put_line('upd_destination - l_nbre_rangee: ' || l_nbre_rangee);
      ut.expect(l_nbre_rangee).to_equal(1);
   end upd_destination; 


   -- test del
   procedure del_destination is
      l_nbre_rangee    number := 2;
      l_id_destination number := 1;
   begin
      l_reponse_obj := destination_tapi.del_destination(
         l_id_destination,
         'O'
      );
      dbms_output.put_line('del_destination - l_id_destination: ' || l_id_destination);
      dbms_output.put_line('del_destination - l_reponse_obj: ' || l_reponse_obj);
      l_nbre_rangee := json_value(l_reponse_obj,
           '$.nbre_rangee');
      dbms_output.put_line('del_destination - l_nbre_rangee: ' || l_nbre_rangee);
      ut.expect(l_nbre_rangee).to_be_greater_or_equal(0); -- si ligne existe plus
   end del_destination;



   -- test get
   procedure get_destination is
      l_id_destination   number := 1;
      l_json_destination varchar2(4000);
      l_expected         l_json_destination%type := 'TEST';
   begin
      l_expected := '{"ID_DESTINATION":'
                    || l_id_destination
                    || ',"CITY":"Lyon","COUNTRY":"France","IMAGE_LINK":"lyon.jpg"}';
      l_json_destination := destination_tapi.get_destination(l_id_destination);
      dbms_output.put_line('l_JSON_destination: ' || l_json_destination);
      dbms_output.put_line('l_expected: ' || l_expected);
      ut.expect(l_json_destination).to_equal(l_expected);
   end get_destination;

end test_destination_tapi;